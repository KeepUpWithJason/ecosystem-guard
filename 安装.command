#!/bin/bash
# 双击安装：脚本会自己弹出系统密码框，输入开机密码即可
cd "$(dirname "$0")" || exit 1

clear
echo "════════════════════════════════════════════"
echo "  EcosystemGuard 安装"
echo "════════════════════════════════════════════"
echo
echo "接下来会弹出系统密码框，请输入你的开机密码。"
echo

/bin/bash ./install.sh

echo
echo "════════════════════════════════════════════"
read -r -p "按回车键关闭窗口..." _
